{
  "name": "anti-ai",
  "version": "3.2.0",
  "description": "Turn local coding-agent token usage into a satirical resource receipt, mutation creature, and containment expedition.",
  "type": "module",
  "bin": {
    "anti-ai": "bin/anti-ai.mjs"
  },
  "scripts": {
    "build:tui": "node scripts/build-tui.mjs",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.mjs\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=75 test/*.test.mjs",
    "test:package": "npm run build:tui && node scripts/verify-package.mjs",
    "check": "npm run build:tui && node scripts/check.mjs",
    "verify": "npm run build:tui && node scripts/check.mjs && npm run test:coverage && node scripts/verify-package.mjs",
    "prepublishOnly": "npm run verify",
    "start": "node ./bin/anti-ai.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "skills",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppxu/anti-ai.git"
  },
  "bugs": {
    "url": "https://github.com/ppxu/anti-ai/issues"
  },
  "homepage": "https://github.com/ppxu/anti-ai#readme",
  "keywords": [
    "ai",
    "token",
    "codex",
    "claude-code",
    "opencode",
    "openclaw",
    "hermes-agent",
    "pi-coding-agent",
    "agent-skills",
    "cli",
    "svg",
    "terminal-game",
    "virtual-pet",
    "ascii-art",
    "local-first",
    "sustainability",
    "carbon-footprint",
    "privacy"
  ],
  "author": "Yang Xu (https://github.com/ppxu)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.8"
  }
}
